{
  "name": "@devforge/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "ts-ast": "npm:typescript@5.9",
    "typescript": "^7.0.2",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
