# DevForge AI server configuration. Copy to server/.env and adjust.
# Never commit server/.env — it is git-ignored.

# ── Core ──────────────────────────────────────────────────────────────
PORT=4000
# Public URL of the web app (used for CSRF origin checks, links in emails, webhook URLs)
APP_URL=http://localhost:5173
# 32+ random characters. Encrypts stored secrets (API keys, tokens, webhook secrets).
# Required in production; in development one is generated into data/app/.app-secret.
# APP_SECRET=
# NODE_ENV=production
# DATA_DIR=./data/app
# DATABASE_PATH=./data/app/devforge.db
SESSION_TTL_HOURS=168
# Set to 1 when running behind a reverse proxy (X-Forwarded-For)
# TRUST_PROXY=1

# ── AI (Claude) ───────────────────────────────────────────────────────
# Optional. Workspace admins can instead add a key in Integrations (stored encrypted).
# Without a key, static analysis, scans, sandboxed tests and deterministic agents still work.
# ANTHROPIC_API_KEY=
DEVFORGE_AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SEC=300
AI_RATE_PER_MIN=30

# ── Repository import ─────────────────────────────────────────────────
# Comma-separated hosts allowed for git URL import ("*" = any public host; private IPs always blocked)
GIT_HOST_ALLOWLIST=github.com,gitlab.com,bitbucket.org,codeberg.org
# Directories that may be imported from the server's disk (empty = local import disabled)
# LOCAL_IMPORT_ROOTS=/Users/me/code
MAX_REPO_MB=300
MAX_INDEXED_FILES=8000
MAX_FILE_KB=512
# Optional server-wide GitHub token for private repositories (workspaces can add their own)
# GITHUB_TOKEN=

# ── Analysis ──────────────────────────────────────────────────────────
# Query OSV.dev for known vulnerabilities in dependencies
OSV_ENABLED=true
JOB_CONCURRENCY=2

# ── Sandboxed execution of repository code ────────────────────────────
# auto | docker | macos | disabled. auto picks Docker, then macOS sandbox-exec, else disabled.
SANDBOX_MODE=auto
SANDBOX_TIMEOUT_SEC=180
# SANDBOX_IMAGE=node:22-bookworm

# ── Email (optional; without SMTP, mails are written to data/app/outbox) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=DevForge AI <no-reply@example.com>

# ── OAuth sign-in (optional) ──────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
